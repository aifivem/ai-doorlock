{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-doorlock/data/doors.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Name",
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "model": {
          "description": "Door model: The GTA model name of the door (a tool like CodeWalker or a model viewer shows it).",
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "coords": {
          "description": "Door position: Pick the door in the world with the free camera (it is outlined when aimed at): its model and exact position are filled in.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "model2": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "coords2": {
          "description": "Second leaf position: Only for double doors: pick the second leaf the same way; empty for a single door.",
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "locked": {
          "description": "Locked at start: The state after a server restart.",
          "type": "boolean"
        },
        "jobs": {
          "description": "Jobs: Empty: anyone may lock and unlock. Otherwise members of these jobs.",
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[a-z0-9_]{2,32}$"
          }
        },
        "distance": {
          "description": "Reach: How close the player must be for the prompt.",
          "type": "number",
          "minimum": 1,
          "maximum": 15
        }
      },
      "required": [
        "label",
        "model",
        "coords",
        "model2",
        "coords2",
        "locked",
        "jobs",
        "distance"
      ]
    }
  },
  "additionalProperties": false
}
