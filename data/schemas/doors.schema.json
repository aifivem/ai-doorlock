{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-doorlock/data/doors.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Name",
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "type": {
          "description": "Door type: Decides how many door objects you pick and how the door locks: swinging doors lock once they are shut, sliding doors and gates lock at once, garage doors and barriers keep the game's own movement.",
          "enum": [
            "single",
            "double",
            "sliding",
            "doubleSliding",
            "garage"
          ]
        },
        "door": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 0,
              "maxLength": 64
            },
            "coords": {
              "description": "Door: Pick the door in the world with the free camera (it is outlined when aimed at): its model and exact position are filled in. For a double door, one of the two leaves.",
              "type": "object",
              "required": [
                "x",
                "y",
                "z"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              }
            }
          },
          "required": [
            "model",
            "coords"
          ]
        },
        "door2": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 0,
              "maxLength": 64
            },
            "coords": {
              "description": "Second door: Only for a double door or a double sliding door: pick the other leaf the same way. Other door types ignore it.",
              "type": "object",
              "required": [
                "x",
                "y",
                "z"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              }
            }
          },
          "required": [
            "model",
            "coords"
          ]
        },
        "locked": {
          "description": "Locked at start: The state after a server restart.",
          "type": "boolean"
        },
        "jobs": {
          "description": "Jobs: Empty: anyone may lock and unlock. Otherwise members of these jobs.",
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[a-z0-9_]{2,32}$"
          }
        },
        "distance": {
          "description": "Reach: How close the player must be for the prompt. Gates and garage doors need more.",
          "type": "number",
          "minimum": 1,
          "maximum": 15
        }
      },
      "required": [
        "label",
        "type",
        "door",
        "door2",
        "locked",
        "jobs",
        "distance"
      ]
    }
  },
  "additionalProperties": false
}
